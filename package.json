{
  "name": "@peerbits/fhir-client",
  "version": "1.0.0",
  "description": "Lightweight, dependency-free FHIR R4 client SDK for Node.js/TypeScript",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.sandbox.test.ts\"",
    "test:sandbox": "vitest run tests/e2e.sandbox.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeerbitsSolution/fhir-client.git"
  },
  "homepage": "https://github.com/PeerbitsSolution/fhir-client#readme",
  "bugs": {
    "url": "https://github.com/PeerbitsSolution/fhir-client/issues"
  },
  "keywords": [
    "fhir",
    "fhir-client",
    "healthcare",
    "hl7",
    "smart-on-fhir",
    "typescript",
    "r4"
  ],
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^4.1.10",
    "eslint": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@types/node": "^20.14.0"
  },
  "engines": {
    "node": ">=20.12"
  }
}
